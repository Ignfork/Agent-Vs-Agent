# ---- Server ----------------------------------------------------------------
PORT=8787
# Long random string. REQUIRED in production (signs session tokens).
SESSION_SECRET=
# Domain shown in the wallet sign-in message (e.g. avagame.xyz). Use your real domain in production.
PUBLIC_DOMAIN=localhost
# Where the JSON store lives (players, agents, matches).
DATA_DIR=data
# Comma-separated origins allowed to call the API / open sockets cross-origin
# (only needed if the client is hosted on a different domain than the server).
ALLOWED_ORIGINS=

# ---- Solana ----------------------------------------------------------------
# devnet | testnet | mainnet-beta   (defaults to devnet)
SOLANA_NETWORK=devnet
# Optional custom RPC (defaults to the public endpoint for the network).
SOLANA_RPC_URL=
# $AVA token mint address. Leave EMPTY until the real mint exists — token
# features stay in "preview" and no address is ever invented.
AVA_MINT=
AVA_DECIMALS=

# ---- Game ------------------------------------------------------------------
SEASON_ID=s1
SEASON_NAME=Season 1 · Static Bloom
TURN_SECONDS=20
READY_SECONDS=20
RECONNECT_SECONDS=45
